# Zentronyx Platform Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO GIT

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Centralized Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8001

# Database Configuration (PostgreSQL)
POSTGRES_USER=zentronyx_user
POSTGRES_PASSWORD=zentronyx_secure_password_change_in_prod
POSTGRES_DB=zentronyx_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async & Sync Database URLs
DATABASE_URL=postgresql+asyncpg://zentronyx_user:zentronyx_secure_password_change_in_prod@postgres:5432/zentronyx_db
SYNC_DATABASE_URL=postgresql://zentronyx_user:zentronyx_secure_password_change_in_prod@postgres:5432/zentronyx_db

# Security & Authentication
JWT_SECRET=CHANGE_THIS_TO_A_32_BYTE_RANDOM_SECRET_KEY_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Core Platform Settings
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
WORKSPACE_ROOT=/tmp/zentronyx_workspaces
SCAN_TIMEOUT=300  # 5 minutes in seconds

# Microservice Integrations
AI_SERVICE_URL=http://ai-service:8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
